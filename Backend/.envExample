PORT=

MONGO_URI=
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=

# ─── Token lifetimes ──────────────────────────────────────────────────────────
# Access token: 1 day. Refresh token: 1 month (30 days).
ACCESS_TOKEN_EXPIRES_IN=
REFRESH_TOKEN_EXPIRES_DAYS=
COOKIE_SAME_SITE=
COOKIE_SECURE=

# ─── AI providers ─────────────────────────────────────────────────────────────
# Order of use: Gemini (primary) -> OpenRouter -> Grok.
# Every key below stays server-side and is never sent to the browser.


# Fallback 1 — OpenRouter
OPENROUTER_API_KEY=your api key
OPENROUTER_MODEL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=
# Fallback 2 — Grok (xAI)
GROK_API_KEY=your api key
GROK_MODEL=
GROK_BASE_URL=
# Shared provider timeout (ms)
AI_REQUEST_TIMEOUT_MS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
